# ----------------------------------------------------------------------
# Transcripts: every task's full output goes to a temp file, unlinked when
# the task exits 0 and listed with its command when it fails.
# ----------------------------------------------------------------------

# Task `a` prints 60 lines — more than its pane holds — then exits 3; task
# `b` prints one line and exits 0.
SPLIT_SCRIPT = (
    '[ "$1" = a ] || { echo ok-b; exit 0; }\n'
    "seq 1 60 | sed s/^/line-/\n"
    "exit 3"
)
SPLIT_CMD = ["sh", "-c", SPLIT_SCRIPT, "_"]


@contextlib.contextmanager
def transcript_dir():
    """Point partty's TMPDIR at a fresh directory and yield it, so a test
    can count exactly the transcripts one run left behind."""
    d = tempfile.mkdtemp(prefix="test-partty-")
    old = os.environ.get("TMPDIR")
    os.environ["TMPDIR"] = d
    try:
        yield d
    finally:
        if old is None:
            del os.environ["TMPDIR"]
        else:
            os.environ["TMPDIR"] = old
        shutil.rmtree(d)


def transcripts(d: str) -> list[str]:
    return sorted(
        os.path.join(d, f) for f in os.listdir(d) if f.startswith("partty-")
    )


def wait_for_ready(d: str, n: int, timeout: float = 3.0) -> None:
    """Block until `n` tasks have touched `$TMPDIR/ready-*`, so a signal
    lands after partty and its tasks are up rather than after a guess."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        if sum(f.startswith("ready-") for f in os.listdir(d)) >= n:
            return
        time.sleep(0.02)
    raise AssertionError(f"{n} tasks never reported ready")


def stray(command: str) -> bool:
    """Whether a process running exactly `command` is still alive; kills any
    it finds, so a failing test leaves nothing behind."""
    pattern = "^" + re.escape(command) + "$"
    found = subprocess.run(["pgrep", "-f", pattern], capture_output=True).stdout
    if found:
        subprocess.run(["pkill", "-9", "-f", pattern])
    return bool(found)


def read_bytes(path: str) -> bytes:
    with open(path, "rb") as f:
        return f.read()


def assert_one_transcript(d: str, newline: bytes) -> str:
    """The failing task's transcript is the only file left, and it holds
    the task's whole output — including lines its pane scrolled away."""
    files = transcripts(d)
    if len(files) != 1:
        raise AssertionError(f"expected one transcript, found {files}")
    body = read_bytes(files[0])
    assert_contains(body, b"line-1" + newline, "first line kept")
    assert_contains(body, b"line-60" + newline, "last line kept")
    assert_not_contains(body, b"ok-b", "passing task's output")
    return files[0]


