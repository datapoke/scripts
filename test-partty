# ----------------------------------------------------------------------
# Test registry — `@test("name")` decorator collects callable tests.
# ----------------------------------------------------------------------

_tests: list[tuple[str, callable]] = []


def test(name: str):
    def wrap(fn):
        _tests.append((name, fn))
        return fn

    return wrap


# ----------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------

PARSPLIT = os.environ.get("PARSPLIT", "partty")

ANSI_RE = re.compile(
    rb"\x1b\[[0-?]*[ -/]*[@-~]"
    rb"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"
    rb"|\x1b[@-Z\\_^]"
)


def strip_ansi(data: bytes) -> bytes:
    return ANSI_RE.sub(b"", data)


def run_partty(
    args: list[str],
    stdin_items: bytes = b"",
    rows: int = 24,
    cols: int = 80,
    timeout: float = 5.0,
    preexec=None,
) -> tuple[bytes, int]:
    """Fork partty under a pty + stdin pipe, capture stdout bytes,
    return (output, exit_status). exit_status is the raw waitpid status.
    `preexec` runs in the forked child just before exec.
    """
    master_fd, slave_fd = pty.openpty()
    fcntl.ioctl(
        slave_fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0)
    )
    r, w = os.pipe()
    if stdin_items:
        os.write(w, stdin_items)
    os.close(w)
    pid = os.fork()
    if pid == 0:
        os.dup2(r, 0)
        os.dup2(slave_fd, 1)
        os.dup2(slave_fd, 2)
        os.close(master_fd)
        if preexec is not None:
            preexec()
        os.execvp(PARSPLIT, [PARSPLIT, *args])
    os.close(slave_fd)
    os.close(r)
    output = b""
    deadline = time.time() + timeout
    child_done = False
    status = 0
    while time.time() < deadline:
        rs, _, _ = select.select([master_fd], [], [], 0.1)
        if rs:
            try:
                chunk = os.read(master_fd, 4096)
            except OSError:
                break
            if not chunk:
                break
            output += chunk
        if not child_done:
            wpid, st = os.waitpid(pid, os.WNOHANG)
            if wpid != 0:
                child_done = True
                status = st
                # Drain remaining output. partty does a final redraw
                # AFTER exit-detection in its main loop (where the [exit N]
                # marker lands), plus a park-below + SHOW_CURSOR. Be
                # generous — wait through 5 consecutive empty selects.
                empty = 0
                drain_until = time.time() + 1.0
                while time.time() < drain_until and empty < 5:
                    rs, _, _ = select.select([master_fd], [], [], 0.1)
                    if not rs:
                        empty += 1
                        continue
                    empty = 0
                    try:
                        chunk = os.read(master_fd, 4096)
                    except OSError:
                        break
                    if not chunk:
                        break
                    output += chunk
                break
    if not child_done:
        try:
            os.kill(pid, 15)
        except ProcessLookupError:
            pass
        try:
            _, status = os.waitpid(pid, 0)
        except ChildProcessError:
            pass
    try:
        os.close(master_fd)
    except OSError:
        pass
    return output, status


def assert_contains(haystack: bytes, needle: bytes, label: str = ""):
    if needle not in haystack:
        raise AssertionError(
            f"missing {needle!r}" + (f" ({label})" if label else "")
        )


def assert_not_contains(haystack: bytes, needle: bytes, label: str = ""):
    if needle in haystack:
        raise AssertionError(
            f"unexpected {needle!r}" + (f" ({label})" if label else "")
        )


def run_piped(args, stdin_items=b"", env=None):
    """Run partty with stdout/stderr as PIPES (NOT a tty) so it exercises the
    non-tty run_plain path. Returns (output_bytes, returncode)."""
    e = os.environ.copy()
    if env:
        e.update(env)
    p = subprocess.run(
        [PARSPLIT, *args], input=stdin_items, capture_output=True, env=e
    )
    return p.stdout, p.returncode


# Two work units so effective parallelism is >= 2 and the pane UI is engaged.
# A SINGLE work unit (or -P1) short-circuits to a non-paned pass-through
# (inherited stdio, no emulator), so every pane test must produce at least
# two panes to actually exercise the VirtualPane.
PANED_STDIN = b"a\nb\n"


def run_paned(cmd: list[str], *, procs: int = 2, **kw) -> tuple[bytes, int]:
    """Run partty with `-P<procs>` over two work units (`PANED_STDIN`) so the
    pane emulator is engaged. Both panes run the identical command — fine for
    presence assertions (`assert_contains`), which are unaffected by the
    duplicated output. `cmd` is the command + args after the `-P` flag.
    """
    return run_partty([f"-P{procs}", *cmd], PANED_STDIN, **kw)


def run_gated_pane(script: str, **kw) -> tuple[bytes, int]:
    """Like `run_paned`, but only ONE pane emits content: with two work units
    (`a`, `b`) under -P2 the emulator is engaged, yet a `$1`-guard makes only
    the `a` pane run `script` while the `b` pane exits silently. That keeps a
    single deterministic pane of content for tests that inspect the tail of the
    captured frame — two concurrent panes would interleave their redraw frames
    and make `rfind(marker)` + `splitlines()` ambiguous (spurious pass/fail).
    `script` is a shell snippet run via `sh -c`.
    """
    gated = f'[ "$1" = a ] || exit 0\n{script}'
    return run_partty(["-P2", "sh", "-c", gated, "_"], PANED_STDIN, **kw)


