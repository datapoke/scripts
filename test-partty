    plain = strip_ansi(out)
    assert_contains(plain, b"partty: 1 of 2 tasks failed")
    assert_contains(plain, b"[exit 3] sh -c")
    assert_contains(plain, path.encode())
    if os.waitstatus_to_exitcode(status) != 3:
