#!/usr/bin/env python3
"""
test-partty — behavioral tests for ~/.local/bin/partty.

Each test forks partty under a fresh pty (size configurable), pipes
stdin items into it, captures all bytes the parent would have seen on its
terminal, and checks for expected behavior. The tests exercise:

    - stdout / stderr / interleaved capture
    - SGR colors (default passthrough + --strip-ansi)
    - bare \\r in-place rewrites (progress bars)
    - CRLF line endings from cooked-mode pty
    - virtual-pane cursor moves (CUU + CUP) staying inside the pane
    - ED (\\x1b[2J) + cursor home, line-feed scroll
    - SGR canonicalization under long unreset chains (regression: byte
      cap truncation used to chop sequences mid-byte and render
      "9mnpm"/"2mnpm" garbage)
    - slot reuse with more items than parallelism
    - nonzero exit code propagation
    - per-task transcripts: kept and listed on failure, unlinked on success

Usage:
    test-partty            # run all
    test-partty -v         # show captured tail of each test on failure
    test-partty -k <pat>   # only tests with <pat> in their name
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import os
import pty
import re
import resource
