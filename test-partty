def _spawn_plain(script: str) -> subprocess.Popen:
    """partty off a tty over tasks a and b, in its own session."""
    r, w = os.pipe()
    os.write(w, PANED_STDIN)
    os.close(w)
    p = subprocess.Popen(
        [PARSPLIT, "-P2", "sh", "-c", script, "_"],
        stdin=r,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
    )
    os.close(r)
    return p


def _finish(p: subprocess.Popen) -> bytes:
    try:
        _, err = p.communicate(timeout=3)
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, signal.SIGKILL)
        p.communicate()
        raise AssertionError("partty didn't exit after the signal")
    return err


