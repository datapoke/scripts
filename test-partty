@test("captures stdout")
def t_stdout():
    out, _ = run_paned(["sh", "-c", "echo hello; echo world", "_"])
    assert_contains(out, b"hello")
    assert_contains(out, b"world")


@test("captures stderr only")
def t_stderr_only():
    out, _ = run_paned(["sh", "-c", "echo to-stderr >&2", "_"])
    assert_contains(out, b"to-stderr")


@test("captures interleaved stdout + stderr")
def t_interleaved():
    out, _ = run_paned(
        [
            "sh",
            "-c",
            "echo line1; echo err1 >&2; echo line2; echo err2 >&2",
            "_",
        ]
    )
    for w in (b"line1", b"err1", b"line2", b"err2"):
        assert_contains(out, w)


@test("captures git stderr from non-repo")
def t_git_stderr():
    # The work-unit item lands as a trailing pathspec arg; the not-a-repo
    # error fires before pathspec handling, so both panes still error out.
    out, _ = run_paned(["git", "-C", "/tmp", "status"])
    low = out.lower()
    if b"not a git" not in low and b"fatal" not in low:
        raise AssertionError("git error message missing from output")


@test("captures python stderr with nonzero exit")
def t_python_stderr_exit():
    # Keep the cmd line short — the rendered header is truncated to
    # term_cols (80), so a long `python -c` would push [exit N] past the
    # truncation point and look like a regression.
    out, _ = run_paned(["sh", "-c", "echo py-stderr >&2; exit 1", "_"])
    assert_contains(out, b"py-stderr")
    plain = strip_ansi(out)
    if b"[exit 1]" not in plain:
        raise AssertionError("expected [exit 1] marker in rendered header")


@test("SGR colors pass through by default")
def t_sgr_default():
    out, _ = run_paned(
        [
            "sh",
            "-c",
            "printf '\\x1b[31mRED\\x1b[0m and \\x1b[1;32mbold-green\\x1b[0m end\\n'",
            "_",
        ]
    )
    assert_contains(out, b"RED")
    assert_contains(out, b"bold-green")
    # The emulator re-emits canonical SGR — colors should be present.
    if b"\x1b[31m" not in out:
        raise AssertionError("expected red SGR (\\x1b[31m) in output")


@test("--strip-ansi drops SGR from rendered output")
def t_strip_ansi():
    out, _ = run_partty(
        [
            "-S",
            "-P2",
            "sh",
            "-c",
            "printf '\\x1b[31mRED\\x1b[0m text\\n'",
            "_",
        ],
        PANED_STDIN,
    )
    assert_contains(out, b"RED")
    # The SGR around RED should be gone from the rendered pane (partty's
    # own layout escapes — header color, cursor moves — are still present
    # elsewhere; --strip-ansi only filters the rendered cell content). So
    # we check that the immediate before-RED bytes don't include red SGR.
    idx = out.find(b"RED")
    while idx != -1:
        window = out[max(0, idx - 12) : idx]
        if window.endswith(b"\x1b[31m"):
            raise AssertionError("[31m present right before RED under --strip-ansi")
        idx = out.find(b"RED", idx + 1)


@test("\\r progress-bar rewrites in place")
def t_carriage_return():
    out, _ = run_paned(
        [
            "sh",
            "-c",
            "for i in 1 2 3 4 5; do printf 'progress %d/5\\r' $i; sleep 0.1; done; printf 'final\\n'",
            "_",
        ]
    )
    # All intermediate progress states should appear (each in a separate
    # redraw frame), plus the final committed line.
    for w in (
        b"progress 1/5",
        b"progress 2/5",
        b"progress 3/5",
        b"progress 4/5",
        b"progress 5/5",
        b"final",
    ):
        assert_contains(out, w)


@test("CRLF line endings produce non-empty lines")
def t_crlf():
    # Pty cooked mode translates \n -> \r\n. A buggy emulator could split
    # the line on \r before the \n arrived, committing empty content.
    out, _ = run_paned(["sh", "-c", "echo aaa; echo bbb; echo ccc", "_"])
    plain = strip_ansi(out)
    for w in (b"aaa", b"bbb", b"ccc"):
        assert_contains(plain, w)


@test("cursor-up (CUU) overwrites lines inside the pane")
def t_cuu_overwrite():
    # Child does the writes then sleeps briefly so a stable redraw frame
    # lands AFTER the cursor-up + overwrite has been processed. We only
    # examine the bytes AFTER the last "OVERWRITTEN" — earlier frames
    # may legitimately show line2 before the CUU has been processed.
    out, _ = run_gated_pane(
        "printf 'line1\\nline2\\nline3\\n'; "
        "printf '\\x1b[2A'; "
        "printf 'OVERWRITTEN'; "
        "printf '\\x1b[2B\\n'; "
        "printf 'final\\n'; "
        "sleep 0.2"
    )
    plain = strip_ansi(out)
    assert_contains(plain, b"line1")
    assert_contains(plain, b"OVERWRITTEN")
    assert_contains(plain, b"line3")
    assert_contains(plain, b"final")
    # Inspect only the final stable frame: everything from the last
    # "OVERWRITTEN" onward. No bare line == "line2" allowed there.
    last_owr = plain.rfind(b"OVERWRITTEN")
    tail = plain[last_owr:]
    for raw_line in tail.splitlines():
        if raw_line.strip() == b"line2":
            raise AssertionError(
                "line2 still rendered as its own line — CUU didn't overwrite"
            )


@test("ED (erase display) + cursor home clears the pane")
def t_ed_home():
    out, _ = run_gated_pane(
        "printf 'junk1\\njunk2\\njunk3\\n'; "
        "sleep 0.15; "
        "printf '\\x1b[2J\\x1b[H'; "
        "printf 'CLEAN1\\nCLEAN2\\n'"
    )
    plain = strip_ansi(out)
    assert_contains(plain, b"CLEAN1")
    assert_contains(plain, b"CLEAN2")
    # At least one redraw frame after the clear must have CLEAN1 and
    # CLEAN2 without any of the junk visible on the same frame. Easy
    # proxy: somewhere in the byte stream, CLEAN1 appears in a redraw
    # block that does NOT also contain junk1/junk2/junk3 in the same
    # pane region. We use a rough test: a frame where the byte distance
    # between CLEAN1 and the nearest junk* is large.
    c = plain.find(b"CLEAN1")
    j1 = plain.find(b"junk1", c)
    j2 = plain.find(b"junk2", c)
    j3 = plain.find(b"junk3", c)
    later_junk = [x for x in (j1, j2, j3) if x != -1]
    if later_junk and min(later_junk) - c < 200:
        # junk lingered into a frame right after CLEAN1 — ED didn't fully
        # clear the screen.
        raise AssertionError("junk still visible after \\x1b[2J + \\x1b[H")


@test("SGR canonicalization survives long unreset chain")
def t_sgr_long_chain():
    # Pre-fix: my pane accumulated raw SGR bytes per cell and sliced the
    # last 128 bytes when it grew too long, leaving cells with cut-off
    # sequences like "9mnpm". Now SGR is tracked semantically and re-
    # emitted as a single canonical sequence per cell.
    sgrs = "".join(
        f"\\x1b[3{c}m" for c in range(1, 8) for _ in range(40)
    )  # 280 SGRs
    out, _ = run_paned(
        ["sh", "-c", "printf '%b' '" + sgrs + "VISIBLE\\n'", "_"]
    )
    assert_contains(out, b"VISIBLE")
    # The bytes immediately before "VISIBLE" should be a single complete
    # SGR sequence (ESC [ … m), not a chopped fragment.
    idx = out.rfind(b"VISIBLE")
    window = out[max(0, idx - 20) : idx]
    # Find the LAST SGR sequence in the window. If our canonicalization
    # works, the window ends with `\x1b[<params>m`.
    m = re.search(rb"\x1b\[[0-9;]*m([^\x1b]*)$", window)
    if not m:
        raise AssertionError(
            f"no canonical SGR right before VISIBLE; window={window!r}"
        )
    # Trailing slice after the SGR (between final SGR and "VISIBLE")
    # must be only safe layout bytes — no chopped "Nm" remnants.
    trailing = m.group(1)
    if re.search(rb"[0-9]+m[A-Za-z]", trailing):
        raise AssertionError(
            f"chopped-SGR garbage before VISIBLE: trailing={trailing!r}"
        )


@test("slot reuse with more items than parallelism")
def t_slot_reuse():
    # 5 items, -P3 -> 3 panes; slot reuse means each pane runs multiple
    # tasks. Tighter timings + a more generous test timeout — flaked
    # before when the child's sleep + scheduling pushed past 5s.
    out, _ = run_partty(
        [
            "-P3",
            "sh",
            "-c",
            "printf 'tag %d a\\n' \"$1\"; "
            "printf 'tag %d b\\n' \"$1\"",
            "_",
        ],
        b"1\n2\n3\n4\n5\n",
        timeout=15.0,
    )
    plain = strip_ansi(out)
    for tag_id in (1, 2, 3, 4, 5):
        for sub in ("a", "b"):
            tag = f"tag {tag_id} {sub}".encode()
            assert_contains(plain, tag)


@test("nonzero exit code propagates to the header")
def t_exit_code():
    out, _ = run_paned(["sh", "-c", "exit 7", "_"])
    plain = strip_ansi(out)
    assert_contains(plain, b"[exit 7]")


@test("LINES / COLUMNS env vars are set for the child")
def t_env_lines_cols():
    out, _ = run_paned(
        ["sh", "-c", "echo lines=$LINES cols=$COLUMNS", "_"],
        rows=24,
        cols=80,
    )
    plain = strip_ansi(out)
    # Two panes split the 24 rows, so per-pane LINES is layout-dependent
    # (~10-12); COLUMNS stays at the full width (80). Assert both are
    # exported and positive, with the full width preserved.
    m = re.search(rb"lines=(\d+) cols=(\d+)", plain)
    if not m or int(m.group(1)) <= 0 or int(m.group(2)) != 80:
        raise AssertionError(
            f"LINES / COLUMNS not exported to child as expected; got {plain!r}"
        )


@test("ESC D (IND) advances to next row")
def t_ind():
    # ESC D is a single-byte line feed used by some TUI tools and build
    # systems instead of \n. If the emulator drops it, two lines collapse
    # onto one row.
    out, _ = run_gated_pane("printf 'aaa\\x1bDbbb\\x1bDccc\\r\\n'; sleep 0.2")
    plain = strip_ansi(out)
    # Inspect the final stable frame.
    tail = plain[plain.rfind(b"aaa") :]
    rows = [r.strip() for r in tail.splitlines() if r.strip()]
    # Without ESC D handling: aaabbbccc would be on a single row.
    if b"aaabbbccc" in b" ".join(rows):
        raise AssertionError("ESC D didn't line-feed — aaa/bbb/ccc collapsed")


@test("ESC E (NEL) does CR + LF")
def t_nel():
    out, _ = run_gated_pane("printf 'left\\x1bEright\\r\\n'; sleep 0.2")
    plain = strip_ansi(out)
    tail = plain[plain.rfind(b"left") :]
    rows = [r.strip() for r in tail.splitlines()]
    # 'left' and 'right' must end up on different rows.
    if b"leftright" in b" ".join(rows):
        raise AssertionError("ESC E didn't CR+LF — left+right ran together")


@test("\\f (form feed) acts as a line feed")
def t_form_feed():
    out, _ = run_gated_pane("printf 'top\\fmid\\fbot\\r\\n'; sleep 0.2")
    plain = strip_ansi(out)
    tail = plain[plain.rfind(b"top") :]
    if b"topmidbot" in b" ".join(r.strip() for r in tail.splitlines()):
        raise AssertionError("\\f was dropped — top/mid/bot collapsed")


def _run_and_signal_partty(
    args, stdin_items, sig, after_s=0.3, deadline=5.0, sig2=None, after2=0.4
):
    """Spawn partty, send it `sig` after `after_s` (and optionally `sig2` a
    further `after2` later), return (output, status, elapsed). `output` is
    whatever bytes partty wrote to its pty before exit; `status` is the raw
    waitpid status (None if it never exited)."""
    master_fd, slave_fd = pty.openpty()
    fcntl.ioctl(
        slave_fd, termios.TIOCSWINSZ, struct.pack("HHHH", 24, 80, 0, 0)
    )
    r, w = os.pipe()
    if stdin_items:
        os.write(w, stdin_items)
    os.close(w)
    pid = os.fork()
    if pid == 0:
        os.dup2(r, 0)
        os.dup2(slave_fd, 1)
        os.dup2(slave_fd, 2)
        os.close(master_fd)
        os.execvp(PARSPLIT, [PARSPLIT, *args])
    os.close(slave_fd)
    os.close(r)
    start = time.time()
    time.sleep(after_s)
    try:
        os.kill(pid, sig)
    except ProcessLookupError:
        pass
    second_at = time.time() + after2 if sig2 is not None else None
    output = b""
    while time.time() - start < deadline:
        if second_at is not None and time.time() >= second_at:
            second_at = None
            try:
                os.kill(pid, sig2)
            except ProcessLookupError:
                pass
        try:
            rs, _, _ = select.select([master_fd], [], [], 0.05)
            if rs:
                try:
                    chunk = os.read(master_fd, 4096)
                except OSError:
                    pass
                else:
                    if chunk:
                        output += chunk
        except Exception:
            pass
        wpid, status = os.waitpid(pid, os.WNOHANG)
        if wpid != 0:
            # Drain any trailing bytes (e.g. a traceback flushed at exit).
            while True:
                rs, _, _ = select.select([master_fd], [], [], 0.1)
                if not rs:
                    break
                try:
                    chunk = os.read(master_fd, 4096)
                except OSError:
                    break
                if not chunk:
                    break
                output += chunk
            try:
                os.close(master_fd)
            except OSError:
                pass
            return output, status, time.time() - start
    # Didn't exit within deadline — escalate.
    try:
        os.kill(pid, 9)
        os.waitpid(pid, 0)
    except (ProcessLookupError, ChildProcessError):
        pass
    try:
        os.close(master_fd)
    except OSError:
        pass
    return output, None, time.time() - start


@test("SIGINT cleanly exits with long-running child")
def t_sigint():
    import signal as _sig

    _out, status, elapsed = _run_and_signal_partty(
        ["-P2", "sleep", "10"], PANED_STDIN, _sig.SIGINT
    )
    if status is None:
        raise AssertionError(
            f"partty didn't exit within deadline after SIGINT ({elapsed:.2f}s)"
        )
    if elapsed > 2.0:
        raise AssertionError(
            f"partty took {elapsed:.2f}s to exit after SIGINT (too slow)"
        )


