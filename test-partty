def exit_code(status: int) -> int:
    return os.waitstatus_to_exitcode(status)


def failure_report(out: bytes) -> bytes:
    """The part of partty's output from the failure list onward."""
    plain = strip_ansi(out)
    at = plain.find(b"tasks failed")
    if at < 0:
        raise AssertionError("no failure list")
    return plain[at:]


@test("a full transcript disk doesn't stall the task")
def t_transcript_write_error():
    # RLIMIT_FSIZE turns transcript writes into EFBIG (Python ignores
    # SIGXFSZ). The task writes more than a pty buffer holds, so a reader
    # that stopped draining would block it forever.
    def limit():
        resource.setrlimit(resource.RLIMIT_FSIZE, (64, 64))

    with transcript_dir():
        out, status = run_gated_pane(
            "head -c 65536 /dev/zero | tr '\\0' x; exit 3", preexec=limit
        )
    if exit_code(status) != 3:
        raise AssertionError(f"expected exit 3, got status {status}")
    assert_contains(failure_report(out), b"(incomplete: ")


