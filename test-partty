def main():
    ap = argparse.ArgumentParser(
        description="Behavioral tests for partty."
    )
    ap.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="On failure, print the last 800 bytes of captured output.",
    )
    ap.add_argument(
        "-k",
        "--filter",
        default="",
        help="Only run tests whose name contains this substring.",
    )
    args = ap.parse_args()

    # Confirm partty is on PATH.
    try:
        subprocess.run(
            [PARSPLIT, "--help"], capture_output=True, timeout=5
        )
    except FileNotFoundError:
        print(
            f"\033[1;31merror\033[0m: {PARSPLIT!r} not found on PATH "
            f"(set PARSPLIT=<abs path> to override)",
            file=sys.stderr,
        )
        sys.exit(2)

    selected = [
        (n, fn) for n, fn in _tests if not args.filter or args.filter in n
    ]
    if not selected:
        print(f"no tests match filter {args.filter!r}", file=sys.stderr)
        sys.exit(2)

    passed = failed = 0
    failed_names: list[str] = []
    # Pad every name to the longest one (min 55) so the PASS/FAIL column
    # stays vertically aligned even when a test name overflows 55 chars.
    name_w = max(55, *(len(n) for n, _ in selected))
    # Failing tasks leave transcripts; keep them out of the real TMPDIR.
    with transcript_dir():
        for name, fn in selected:
            sys.stdout.write(f"  {name:<{name_w}s} ")
            sys.stdout.flush()
            try:
                fn()
            except AssertionError as e:
                print(f"\033[1;31mFAIL\033[0m  {e}")
                failed += 1
                failed_names.append(name)
                if args.verbose:
                    # Re-run the test inside a try/except to capture the output
                    # — but we already discarded it. Just note the test name.
                    pass
            except Exception as e:
                print(f"\033[1;31mERROR\033[0m {type(e).__name__}: {e}")
                failed += 1
                failed_names.append(name)
            else:
                print("\033[1;32mPASS\033[0m")
                passed += 1

    total = passed + failed
    color = "\033[1;32m" if failed == 0 else "\033[1;31m"
    print()
    print(
        f"{color}{passed}/{total} passed, {failed} failed\033[0m"
    )
    if failed_names and not args.verbose:
        print("  re-run with -v <name> for details on:")
        for n in failed_names:
            print(f"    {n}")
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
