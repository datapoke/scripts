@test("Ctrl-C during pass-through exits cleanly, no traceback")
def t_passthrough_sigint_clean():
    import signal as _sig

    # Single work unit -> pass-through. SIGINT goes to partty alone (not the
    # child's group). partty must handle it: forward to the child, exit 130,
    # and NOT dump a Python KeyboardInterrupt traceback.
    out, status, elapsed = _run_and_signal_partty(
        ["-P1", "sh", "-c", "sleep 10", "_"], b"x\n", _sig.SIGINT
    )
    if status is None:
        raise AssertionError(
            f"partty didn't exit after SIGINT in pass-through ({elapsed:.2f}s)"
        )
    assert_not_contains(out, b"Traceback", "SIGINT must be handled, not raised")
    code = os.waitstatus_to_exitcode(status)
    if code != 130:
        raise AssertionError(f"expected exit 130 (128+SIGINT), got {code}")


def _no_stray(tag):
    """Fail-friendly check: no process whose args contain `tag` survives.
    Returns the leftover lines (and SIGKILLs them so a failure can't wedge
    later runs)."""
    import subprocess as _sp

    leftover = _sp.run(
        ["pgrep", "-f", tag], capture_output=True, text=True
    ).stdout.split()
    if leftover:
        _sp.run(["pkill", "-9", "-f", tag])
    return leftover


@test("SIGTERM during pass-through kills the child (no orphan)")
def t_passthrough_sigterm_no_orphan():
    import signal as _sig

    # A unique sleep duration doubles as a findable marker for the child.
    _out, status, elapsed = _run_and_signal_partty(
        ["-P1", "sleep", "987654"], b"", _sig.SIGTERM
    )
    if status is None:
        raise AssertionError(
            f"partty didn't exit after SIGTERM in pass-through ({elapsed:.2f}s)"
        )
    leftover = _no_stray("sleep 987654")
    if leftover:
        raise AssertionError(
            f"child orphaned after partty SIGTERM: {leftover}"
        )


@test("SIGTERM during pass-through kills the whole group (pipeline)")
def t_passthrough_sigterm_group():
    import signal as _sig

    # `sh -c 'sleep | cat'` makes the sleep a GRANDCHILD of partty (a child of
    # the sh). Forwarding to the single sh PID would leave the sleep orphaned;
    # killing the child's process group reaches it. The unique duration is the
    # marker (it appears in the orphaned sleep's own argv).
    _out, status, elapsed = _run_and_signal_partty(
        ["-P1", "sh", "-c", "sleep 987655 | cat", "_"], b"x\n", _sig.SIGTERM
    )
    if status is None:
        raise AssertionError(
            f"partty didn't exit after SIGTERM ({elapsed:.2f}s)"
        )
    leftover = _no_stray("sleep 987655")
    if leftover:
        raise AssertionError(
            f"pipeline grandchild orphaned (group not killed): {leftover}"
        )


@test("a second signal force-kills a child that ignores the first")
def t_passthrough_escalate():
    import signal as _sig

    # The child traps TERM and never exits; only a SIGKILL escalation on the
    # SECOND signal can stop it. (Each transient `sleep 0.2` would die to the
    # first TERM, but the trapping sh loop survives until SIGKILL.)
    tag = "partty_escalate_987656"
    _out, status, elapsed = _run_and_signal_partty(
        ["-P1", "sh", "-c", f'trap "" TERM; while :; do sleep 0.2; done # {tag}', "_"],
        b"x\n",
        _sig.SIGTERM,
        sig2=_sig.SIGTERM,
        after2=0.6,
        deadline=6.0,
    )
    leftover = _no_stray(tag)
    if status is None:
        raise AssertionError(
            f"partty didn't exit after the second signal ({elapsed:.2f}s)"
        )
    if leftover:
        raise AssertionError(
            f"trapping child survived two signals (no SIGKILL escalation): {leftover}"
        )


