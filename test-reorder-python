            f.write(SWAP_SRC)
        subprocess.run(
            [sys.executable, REORDER, "--write", "__tests__/x.py"], cwd=d, check=True
        )
        with open(os.path.join(d, "__tests__", "x.py")) as f:
            if f.read() != SWAP_SRC:
                raise AssertionError("a __tests__/ file was reordered")


@test("an unwritable file fails its line and the run goes on")
def t_unwritable_dir():
    with tempfile.TemporaryDirectory() as d:
        locked, open_ = os.path.join(d, "locked"), os.path.join(d, "open")
        for sub in (locked, open_):
            os.makedirs(sub)
            with open(os.path.join(sub, "m.py"), "w") as f:
                f.write(SWAP_SRC)
        os.chmod(locked, 0o555)
        try:
            p = subprocess.run(
                [sys.executable, REORDER, "--write",
                 os.path.join(locked, "m.py"), os.path.join(open_, "m.py")],
                capture_output=True, text=True,
            )
        finally:
            os.chmod(locked, 0o755)
        if "Traceback" in p.stderr or "write failed" not in p.stderr or p.returncode != 1:
            raise AssertionError(f"exit {p.returncode}: {p.stderr!r}")
        with open(os.path.join(open_, "m.py")) as f:
            assert_before(f.read(), "def caller", "def helper")


@test("mixed line endings and no final newline survive byte for byte")
def t_mixed_newlines():
    src = (
        b"# x\r\n"
        b"class A:\n"
        b"    def helper(self):\r\n"
        b"        return 1\n"
        b"\n"
        b"    def caller(self):\n"
        b"        return self.helper()"
    )
    # A member's inner terminators travel with it; its last line's stays put.
    want = (
        b"# x\r\n"
        b"class A:\n"
        b"    def caller(self):\n"
        b"        return self.helper()\n"
        b"\n"
        b"    def helper(self):\r\n"
        b"        return 1"
    )
    out, rc = run_bytes(src)
    if rc != 0 or out != want:
        raise AssertionError(f"exit {rc}: {out!r}")


