@test("--check reports and exits 1; a clean file exits 0")
def t_check():
    src = """
        class C:
            def helper(self):
                pass

            def caller(self):
                self.helper()
        """
    out, log, rc = run(src, "--check")
    if rc != 1 or "~ " not in log:
        raise AssertionError(f"expected exit 1 and a report; got {rc} {log!r}")
    assert_before(out, "def helper", "def caller")
    _, _, rc = run(written(src), "--check")
    if rc != 0:
        raise AssertionError(f"reordered output should pass --check; got {rc}")


@test("the default run reports without writing")
def t_dry_run():
    out, log, rc = run(
        """
        class C:
            def helper(self):
                pass

            def caller(self):
                self.helper()
        """
    )
    if rc != 0 or "reordered: caller, helper" not in log:
        raise AssertionError(f"got {rc} {log!r}")
    assert_before(out, "def helper", "def caller")


SWAP_SRC = (
    "class C:\n"
    "    def helper(self):\n"
    "        pass\n"
    "\n"
    "    def caller(self):\n"
    "        self.helper()\n"
)


def run_bytes(data: bytes) -> tuple[bytes, int]:
    with tempfile.TemporaryDirectory() as d:
        path = os.path.join(d, "fixture.py")
        with open(path, "wb") as f:
            f.write(data)
        p = subprocess.run(
            [sys.executable, REORDER, "--write", path], capture_output=True
        )
        with open(path, "rb") as f:
            return f.read(), p.returncode


@test("CRLF line endings survive byte for byte")
def t_crlf():
    out, rc = run_bytes(SWAP_SRC.replace("\n", "\r\n").encode())
    if rc != 0 or out.count(b"\r\n") != SWAP_SRC.count("\n"):
        raise AssertionError(f"exit {rc}: {out!r}")
    assert_before(out.decode(), "def caller", "def helper")


@test("a form feed between methods is not a line break")
def t_form_feed():
    src = SWAP_SRC.replace("    def caller", "\x0c\n    def caller")
    out, rc = run_bytes(src.encode())
    if rc != 0:
        raise AssertionError(f"exit {rc}: {out!r}")
    assert_before(out.decode(), "def caller", "def helper")


@test("a non-UTF-8 coding cookie is honoured")
def t_coding_cookie():
    src = "# -*- coding: latin-1 -*-\n" + SWAP_SRC.replace("pass", "'caf\xe9'")
    out, rc = run_bytes(src.encode("latin-1"))
    if rc != 0 or "caf\xe9".encode("latin-1") not in out:
        raise AssertionError(f"exit {rc}: {out!r}")
    assert_before(out.decode("latin-1"), "def caller", "def helper")


@test("a file with no final newline reorders cleanly")
def t_no_final_newline():
    out, rc = run_bytes(SWAP_SRC.rstrip("\n").encode())
    if rc != 0 or out.endswith(b"\n") or out.count(b"\n") != SWAP_SRC.count("\n") - 1:
        raise AssertionError(f"exit {rc}: {out!r}")
    assert_before(out.decode(), "def caller", "def helper")


@test("--write through a symlink rewrites its target, keeping the link")
def t_symlink():
    with tempfile.TemporaryDirectory() as d:
        real, link = os.path.join(d, "real.py"), os.path.join(d, "link.py")
        with open(real, "w") as f:
            f.write(SWAP_SRC)
        os.symlink("real.py", link)
        subprocess.run([sys.executable, REORDER, "--write", link], check=True)
        if not os.path.islink(link):
            raise AssertionError("the symlink was replaced by a file")
        with open(real) as f:
            assert_before(f.read(), "def caller", "def helper")


@test("a relative __tests__/ path is skipped")
def t_relative_tests_dir():
    with tempfile.TemporaryDirectory() as d:
        os.makedirs(os.path.join(d, "__tests__"))
