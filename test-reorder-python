@test("generic policy: an unrelated root doesn't wedge into a chain")
def t_locality():
    out = written(
        """
        class Locality:
            def chain_leaf(self):
                pass

            def chain_top(self):
                self.chain_mid()

            def loner(self):
                self.loner_help()

            def chain_mid(self):
                self.chain_leaf()

            def loner_help(self):
                pass
