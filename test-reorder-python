@test("absolute paths work from a deleted working directory")
def t_deleted_cwd():
    with tempfile.TemporaryDirectory() as d:
        repo = os.path.join(d, "repo")
        os.makedirs(repo)
        with open(os.path.join(repo, "x.py"), "w") as f:
            f.write(SWAP_SRC)
        gone = os.path.join(d, "gone")
        os.makedirs(gone)
        p = subprocess.Popen(
            ["sh", "-c", 'rmdir "$0" && exec "$@"', gone, sys.executable, REORDER,
             "--write", os.path.join(repo, "x.py")],
            cwd=gone, stderr=subprocess.PIPE,
        )
        _, err = p.communicate(timeout=10)
        if p.returncode != 0:
            raise AssertionError(f"exit {p.returncode}: {err!r}")
        with open(os.path.join(repo, "x.py")) as f:
            assert_before(f.read(), "def caller", "def helper")


