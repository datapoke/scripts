#!/usr/bin/env python3
"""
test-reorder-python — behavioral tests for reorder-python.py.

The PHP twin's `test-reorder-node-methods.sh` holds its orderings; each case
here ports one of its fixtures to Python, then covers the hazards Python adds:
a class body executes top to bottom at definition time, so a decorator, a
default or a class attribute that names another member pins the order.

Usage:
    test-reorder-python            # run all
    test-reorder-python -k <pat>   # only tests with <pat> in their name
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
import tempfile
import textwrap

HERE = os.path.dirname(os.path.realpath(__file__))
REORDER = os.environ.get("REORDER", os.path.join(HERE, "reorder-python.py"))

_tests: list[tuple[str, callable]] = []


def test(name: str):
    def wrap(fn):
        _tests.append((name, fn))
        return fn

    return wrap


def run(src: str, *flags: str, name: str = "fixture.py", subdir: str = ""):
    """Write `src` to a temp file, run the reorderer over it with `flags`,
    and return (file text afterwards, stdout + stderr, exit code)."""
    with tempfile.TemporaryDirectory() as d:
        path = os.path.join(d, subdir, name)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(textwrap.dedent(src).lstrip("\n"))
        p = subprocess.run(
            [sys.executable, REORDER, *flags, path], capture_output=True, text=True
        )
        with open(path) as f:
            return f.read(), p.stdout + p.stderr, p.returncode


def written(src: str, *flags: str, **kw) -> str:
    out, log, rc = run(src, "--write", *flags, **kw)
    if rc != 0:
        raise AssertionError(f"exit {rc}: {log}")
    compile(out, "fixture.py", "exec")
    return out


def assert_before(text: str, first: str, second: str) -> None:
    a, b = text.find(first), text.find(second)
    if a < 0 or b < 0:
        raise AssertionError(f"missing {first!r} or {second!r} in:\n{text}")
    if a > b:
        raise AssertionError(f"{second!r} came before {first!r} in:\n{text}")


def assert_unchanged(src: str, *flags: str) -> str:
    out, log, rc = run(src, "--write", *flags)
    if out != textwrap.dedent(src).lstrip("\n"):
        raise AssertionError(f"expected no change; got:\n{out}")
    return log


# ----------------------------------------------------------------------
# (A) Call-graph receiver scoping
# ----------------------------------------------------------------------


@test("every self-dispatch form is an edge")
def t_self_forms():
    out = written(
        """
        class SelfformsNode(Node):
            def fill(self, message):
                self.step()

            def ztail(self):
                pass

            def step(self):
                SelfformsNode.deep()

            @classmethod
            def deep(cls):
                cls.tip()

            @staticmethod
            def tip():
                pass
        """
    )
    assert_before(out, "def step", "def ztail")
    assert_before(out, "def deep", "def ztail")


@test("a call on another object is not an edge")
def t_foreign_no_cycle():
    # leaf -> other.root_call() would close a cycle if read as a self-call.
    out = written(
        """
        class ForeignNode(Node):
            def fill(self, message):
                self.root_call()

            def leaf(self, other):
                other.root_call()

            def root_call(self):
                self.mid()

            def mid(self):
                self.leaf(None)
        """
    )
    assert_before(out, "def root_call", "def mid")
    assert_before(out, "def mid", "def leaf")


# ----------------------------------------------------------------------
# (B) NODE policy
# ----------------------------------------------------------------------


@test("node policy: a dual-homed helper sinks below every caller")
def t_dual_homed_node():
    out = written(
        """
        class DualhomedNode(Node):
            def fill(self, message):
                self.materialize()

            def materialize(self):
                self.apply_mode()

            def mode_a(self):
                self.set_mode()

            def mode_b(self):
                self.set_mode()

            def set_mode(self):
                self.apply_mode()

            def apply_mode(self):
                pass
        """
    )
    assert_before(out, "def set_mode", "def apply_mode")
    assert_before(out, "def mode_b", "def apply_mode")
    assert_before(out, "def mode_b", "def set_mode")


@test("node policy: the lifecycle prefix leads, node_schema trails")
def t_node_prefix():
    out = written(
        """
        class PrefixNode(Node):
            @classmethod
            def node_schema(cls):
                return {}

            def fire(self):
                pass

            def fill(self, message):
                pass

            def arguments(self, args):
                pass

            def __init__(self):
                pass

            def fire_cb(self):
                pass
        """
    )
    for a, b in [
        ("def __init__", "def arguments"),
        ("def arguments", "def fill"),
        ("def fill", "def fire_cb"),
        ("def fire_cb", "def fire("),
        ("def fire(", "def node_schema"),
    ]:
        assert_before(out, a, b)


@test("node policy: standalone methods follow the connected block")
def t_standalone():
    out = written(
        """
        class StandaloneNode(Node):
            def alpha(self):
                pass

            def fill(self, message):
                self.worker()

            def beta(self):
                pass

            def worker(self):
                pass
        """
    )
    assert_before(out, "def worker", "def alpha")
    assert_before(out, "def alpha", "def beta")


@test("node policy: the base Node class itself")
def t_base_node():
    out = written(
        """
        class Node:
            def helper(self):
                pass

            def caller_a(self):
                self.helper()

            def caller_b(self):
                self.helper()
        """
    )
    assert_before(out, "def caller_a", "def helper")
    assert_before(out, "def caller_b", "def helper")


