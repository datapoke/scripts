@test("the class docstring stays first")
def t_docstring():
    out = written(
        '''
        class Doc:
            """Doc string."""

            def helper(self):
                pass

            def caller(self):
                self.helper()
        '''
    )
    assert_before(out, '"""Doc string."""', "def caller")
    assert_before(out, "def caller", "def helper")


@test("blank-line spacing stays where it was")
def t_spacing():
    out = written(
        """
        class Spacing:
            __slots__ = ("a",)

            def helper(self):
                pass

            def caller(self):
                self.helper()
        """
    )
    want = textwrap.dedent(
        """
        class Spacing:
            __slots__ = ("a",)

            def caller(self):
                self.helper()

            def helper(self):
                pass
        """
    ).lstrip("\n")
    if out != want:
        raise AssertionError(f"got:\n{out}")


@test("comments travel with their own member")
def t_comments():
    out = written(
        """
        class Cmt:
            # helper's lead comment
            def helper(self):
                pass
                # helper's tail comment

            def caller(self):  # caller's same-line comment
                self.helper()
        """
    )
    assert_before(out, "def caller(self):  # caller's same-line comment", "# helper's lead")
    assert_before(out, "# helper's lead comment", "def helper")
    assert_before(out, "def helper", "# helper's tail comment")


@test("nested and module-level code is not reordered")
def t_scope():
    out = written(
        """
        def module_helper():
            pass


        def module_caller():
            module_helper()


        class Outer:
            def go(self):
                class Inner:
                    def b(self):
                        pass

                    def a(self):
                        self.b()

                return Inner
        """
    )
    assert_before(out, "def module_helper", "def module_caller")
    assert_before(out, "def b", "def a")


