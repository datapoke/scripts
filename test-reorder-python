    )
    assert_before(out, "def chain_mid", "def loner(")


@test("a call inside a lambda or nested def is the method's own edge")
def t_closure_edges():
    for body in (
        "self.deferring(lambda: self.flush())",
        "def inner():\n                    self.flush()\n\n                self.deferring(inner)",
        "self.deferring(lambda: self.deferring(lambda: self.flush()))",
    ):
        out = written(
            f"""
        class ClosureScopeNode(Node):
            def fill(self, message):
                self.relay()

            def flush(self):
                self.sink_it()

            def relay(self):
                {body}

            def deferring(self, cb):
                pass

            def sink_it(self):
                pass
        """
        )
        assert_before(out, "def relay", "def flush")


