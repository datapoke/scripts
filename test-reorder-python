@test("a field stays put; methods reorder only between fields")
def t_field_barrier():
    out = written(
        """
        class BarrierNode(Node):
            def helper(self):
                pass

            def fill(self, message):
                self.helper()

            MID_CONST = 1

            def tail(self):
                pass

            def worker(self):
                self.tail()
        """
    )
    assert_before(out, "def fill", "def helper")
    assert_before(out, "def helper", "MID_CONST")
    assert_before(out, "MID_CONST", "def worker")
    assert_before(out, "def worker", "def tail")


@test("a method whose decorator may register it keeps its slot")
def t_decorator_barrier():
    out = written(
        """
        class Model:
            def helper(self):
                pass

            @validator("x")
            def check_x(cls, v):
                return v

            def caller(self):
                self.helper()
        """
    )
    assert_before(out, "def helper", "def check_x")
    assert_before(out, "def check_x", "def caller")


@test("--sort-fields is refused: field order is semantic in Python")
def t_no_sort_fields():
    _, log, rc = run(
        """
        class C:
            def go(self):
                pass
        """,
        "--sort-fields",
    )
    if rc != 1 or "usage:" not in log:
        raise AssertionError(f"expected a usage error; got {rc} {log!r}")


# ----------------------------------------------------------------------
# (E) Definition-time order: Python runs a class body top to bottom
# ----------------------------------------------------------------------


@test("a property setter chain leaves its class alone")
def t_property_chain():
    log = assert_unchanged(
        """
        class Prop:
            @property
            def x(self):
                return self._read()

            @x.setter
            def x(self, v):
                pass

            def _read(self):
                return self.helper()

            def helper(self):
                pass

            def caller(self):
                self.helper()
        """
    )
    if "definition-time" not in log:
        raise AssertionError(f"expected a definition-time note; got {log!r}")


@test("a class attribute holding a method stays below it")
def t_field_holds_method():
    out = written(
        """
        class Table:
            def _a(self):
                pass

            def caller(self):
                self._a()

            HANDLERS = {"a": _a}
        """
    )
    assert_before(out, "def caller", "def _a")
    assert_before(out, "def _a", "HANDLERS")


