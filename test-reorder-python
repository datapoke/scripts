def main():
    ap = argparse.ArgumentParser(description="Tests for reorder-python.py.")
    ap.add_argument("-k", "--filter", default="")
    args = ap.parse_args()
    selected = [(n, fn) for n, fn in _tests if args.filter in n]
    failed: list[str] = []
    width = max(len(n) for n, _ in selected)
    for name, fn in selected:
        sys.stdout.write(f"  {name:<{width}s} ")
        try:
            fn()
        except AssertionError as e:
            print(f"\033[1;31mFAIL\033[0m  {e}")
            failed.append(name)
        except Exception as e:
            print(f"\033[1;31mERROR\033[0m {type(e).__name__}: {e}")
            failed.append(name)
        else:
            print("\033[1;32mPASS\033[0m")
    color = "\033[1;31m" if failed else "\033[1;32m"
    print(f"\n{color}{len(selected) - len(failed)}/{len(selected)} passed\033[0m")
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
